# Copy to .env on the server and fill in. NEVER commit the real .env.

# Public address of the site (used in sitemap.xml, canonical URLs)
SITE_URL=https://ikrameditrip.com

# SQLite database file and private upload folder (keep both OUTSIDE any public web folder; back them up)
DATABASE_PATH=./data/ikra.db
UPLOAD_DIR=./data/uploads

# Set to "true" only when running behind a reverse proxy you control (nginx/Apache/Cloudflare);
# enables per-IP rate limiting using X-Forwarded-For.
TRUST_PROXY=false

# Random secret used to hash visitor IPs stored with leads. Generate: openssl rand -hex 32
IP_HASH_SALT=

# ---- Enquiry e-mail notifications (SMTP). Leads are ALWAYS saved; e-mail status is shown per lead in the admin. ----
# Without these the admin shows "email not configured" — nothing is pretended.
LEAD_NOTIFY_TO=Contactus@ikrameditrip.com
SMTP_HOST=
SMTP_PORT=587
# "true" = implicit TLS (use with port 465). Leave false for port 587 (STARTTLS is then required).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to the recipient; defaults to SMTP_USER when that is an e-mail address.
MAIL_FROM=
